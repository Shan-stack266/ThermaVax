# Copy these values into .env.
SUPABASE_PROJECT_ID=your_project_id
SUPABASE_URL=https://your_project_id.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Browser-facing URL used inside generated QR codes and reset links. Do not include a trailing slash.
# On Vercel, set this to your https://*.vercel.app URL after the first deployment.
PUBLIC_APP_URL=http://localhost:3000

# Comma-separated frontend origins allowed to call the API from another origin.
# Localhost origins are allowed automatically outside production.
APP_ORIGIN=

# Set to 1 only when production Express runs behind one trusted reverse proxy.
TRUST_PROXY=

# Server-only: required for staff-account automation and hardware ingestion.
SUPABASE_SECRET_KEY=
THERMAVAX_DEVICE_KEY=replace_with_a_long_random_device_key
